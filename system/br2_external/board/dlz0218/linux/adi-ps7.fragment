# ADI 2023_R2 / zynq_xcomm_adv7511_defconfig, DLZ0218 PS7 bring-up.
CONFIG_LOCALVERSION="-adi-dlz0218"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
CONFIG_EXTRA_FIRMWARE=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_XILINX_PS_UART=y
CONFIG_SERIAL_XILINX_PS_UART_CONSOLE=y
CONFIG_MACB=y
CONFIG_REALTEK_PHY=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_HIGHMEM=y
# No CPU operating-point changes until board voltages are characterized.
# CONFIG_CPU_FREQ is not set

# Fixed 800x600 framebuffer, owned directly by vdmafb (not xilinx_dma).
CONFIG_FB=y
CONFIG_FB_VDMA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y

# Unmodified ADI I2S ABI + PS PL330 + simple-card, playback only.
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ADI_AXI_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SPDIF=y
CONFIG_PL330_DMA=y
CONFIG_SND_SOC_GENERIC_DMAENGINE_PCM=y
